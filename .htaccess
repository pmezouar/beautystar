RewriteEngine On

# ==========================================
# 1. FORCER HTTPS + SUPPRIMER WWW
# ==========================================

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.beauty-star\.fr$ [NC]
RewriteRule ^ https://beauty-star.fr%{REQUEST_URI} [R=301,L]

# ==========================================
# 2. MASQUER LE RÉPERTOIRE /beautystar
# ==========================================

RewriteCond %{REQUEST_URI} !^/beautystar/
RewriteRule ^(.*)$ /beautystar/$1 [L]

# ==========================================
# 3. PAGE 404 PERSONNALISÉE
# ==========================================

ErrorDocument 404 /beautystar/404.html

# ==========================================
# 4. SUPPRIMER .html DE L'URL
# ==========================================

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# ==========================================
# 5. AJOUTER .html AUTOMATIQUEMENT
# ==========================================

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]